datasource db {
  provider = "sqlite"
}

model Technician {
  tenantId       String        @map("tenant_id")
  techId         String        @map("tech_id")
  pinSalt        String        @map("pin_salt")
  pinHash        String        @map("pin_hash")
  pinCiphertext  String?       @map("pin_ciphertext")
  active         Int           @default(1)
  isAdmin        Int           @default(0) @map("is_admin")
  mustSetup      Int           @default(0) @map("must_change_credentials")
  credentialFingerprint String? @map("credential_fingerprint")
  failedAttempts Int           @default(0) @map("failed_attempts")
  lockedUntil    BigInt        @default(0) @map("locked_until")
  createdAt      BigInt        @map("created_at")
  sessions       TechSession[]

  @@id([tenantId, techId])
  @@index([techId], map: "idx_technicians_global_tech_id")
  @@map("technicians")
}

model TechSession {
  tokenHash  String     @id @map("token_hash")
  tenantId   String     @map("tenant_id")
  techId     String     @map("tech_id")
  expiresAt  BigInt     @map("expires_at")
  createdAt  BigInt     @map("created_at")
  technician Technician @relation(fields: [tenantId, techId], references: [tenantId, techId], onDelete: NoAction, onUpdate: NoAction)

  @@map("tech_sessions")
}

model TechnicianRemoval {
  tenantId String @map("tenant_id")
  techId    String @map("tech_id")
  state     String @default("deleting")
  startedAt BigInt @map("started_at")

  @@id([tenantId, techId])
  @@map("technician_removals")
}

model QcSubmission {
  id                     String  @id
  tenantId               String  @default("default") @map("tenant_id")
  techId                 String  @map("tech_id")
  jobNumber              String  @default("") @map("job_number")
  screenshotId           String  @map("screenshot_id")
  photoIds               String  @map("photo_ids")
  status                 String  @default("pending")
  submittedAt            BigInt  @map("submitted_at")
  reviewedAt             BigInt? @map("reviewed_at")
  reviewNote             String? @map("review_note")
  trustUploadStatus      String  @default("ready") @map("trust_upload_status")
  trustUploadedAt        BigInt? @map("trust_uploaded_at")
  trustExternalReference String? @map("trust_external_reference")
  trustUploadError       String? @map("trust_upload_error")
  trustUploadAttempts    Int     @default(0) @map("trust_upload_attempts")
  trustLastAttemptAt     BigInt? @map("trust_last_attempt_at")
  trustUploadedByKeyId   String? @map("trust_uploaded_by_key_id")
  locationStatus         String? @map("location_status")
  locationLatitude       Float?  @map("location_latitude")
  locationLongitude      Float?  @map("location_longitude")
  locationAccuracy       Float?  @map("location_accuracy")
  locationCapturedAt     BigInt? @map("location_captured_at")
  rootSubmissionId       String? @map("root_submission_id")
  attemptNumber          Int     @default(1) @map("attempt_number")
  correctionPending      Int     @default(0) @map("correction_pending")
  correctionDeadlineAt   BigInt? @map("correction_deadline_at")

  @@index([status, submittedAt], map: "idx_qc_submissions_status_submitted")
  @@index([techId, submittedAt], map: "idx_qc_submissions_tech_submitted")
  @@index([status, trustUploadStatus, reviewedAt, id], map: "idx_qc_submissions_trust_queue")
  @@index([tenantId, status, correctionPending, submittedAt], map: "idx_qc_submissions_tenant_corrections")
  @@map("qc_submissions")
}

model QcSubmissionAttempt {
  tenantId               String  @map("tenant_id")
  rootSubmissionId       String  @map("root_submission_id")
  submissionId           String  @map("submission_id")
  attemptNumber          Int     @map("attempt_number")
  techId                 String  @map("tech_id")
  jobNumber              String  @map("job_number")
  screenshotId           String  @map("screenshot_id")
  photoIds               String  @map("photo_ids")
  status                 String
  submittedAt            BigInt  @map("submitted_at")
  reviewedAt             BigInt? @map("reviewed_at")
  reviewNote             String? @map("review_note")
  trustUploadStatus      String  @default("ready") @map("trust_upload_status")
  trustUploadedAt        BigInt? @map("trust_uploaded_at")
  trustExternalReference String? @map("trust_external_reference")
  trustUploadError       String? @map("trust_upload_error")
  trustUploadAttempts    Int     @default(0) @map("trust_upload_attempts")
  trustLastAttemptAt     BigInt? @map("trust_last_attempt_at")
  trustUploadedByKeyId   String? @map("trust_uploaded_by_key_id")
  locationStatus         String? @map("location_status")
  locationLatitude       Float?  @map("location_latitude")
  locationLongitude      Float?  @map("location_longitude")
  locationAccuracy       Float?  @map("location_accuracy")
  locationCapturedAt     BigInt? @map("location_captured_at")

  @@id([tenantId, rootSubmissionId, attemptNumber])
  @@index([tenantId, rootSubmissionId, attemptNumber], map: "idx_qc_submission_attempts_root")
  @@index([tenantId, submittedAt], map: "idx_qc_submission_attempts_submitted")
  @@map("qc_submission_attempts")
}

model QcUploadPhoto {
  tenantId    String @map("tenant_id")
  submissionId String @map("submission_id")
  techId       String @map("tech_id")
  slot         Int
  image        Bytes
  createdAt    BigInt @map("created_at")

  @@id([tenantId, submissionId, techId, slot])
  @@index([createdAt], map: "qc_upload_photos_created_at_idx")
  @@map("qc_upload_photos")
}

model TrustApiKey {
  id         String  @id
  tenantId   String  @default("default") @map("tenant_id")
  label      String
  tokenHash  String  @unique @map("token_hash")
  tokenHint  String  @map("token_hint")
  createdAt  BigInt  @map("created_at")
  lastUsedAt BigInt? @map("last_used_at")
  revokedAt  BigInt? @map("revoked_at")

  @@map("trust_api_keys")
}

model Tenant {
  id        String @id
  name      String
  active    Int    @default(1)
  createdAt BigInt @map("created_at")

  @@map("tenants")
}

model TenantDomain {
  hostname  String @id
  tenantId  String @map("tenant_id")
  createdAt BigInt @map("created_at")

  @@map("tenant_domains")
}

model LocalMigration {
  name String @id

  @@map("local_migrations")
}
