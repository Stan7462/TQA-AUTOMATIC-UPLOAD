{
  "manifest_version": 3,
  "name": "TQA Catalyst Uploader",
  "version": "0.7.0",
  "description": "Uploads passing and failed TQA QCs, plus corrected follow-ups, to Catalyst.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://catalystqms.comcast.net/*",
    "https://qc.leadtechx.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "TQA Catalyst Uploader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [{
    "matches": ["https://catalystqms.comcast.net/TechOps/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
